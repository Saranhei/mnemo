# Cabeceras de seguridad para Netlify y Cloudflare Pages (se aplican solas al publicar).
# GitHub Pages no las usa; ahí rige la política equivalente de index.html.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
